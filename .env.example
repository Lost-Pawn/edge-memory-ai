# ── Edge device ────────────────────────────────────────────────────────────
EDGE_DEVICE_ID=edge-A
EDGE_DATA_DIR=./data/edge-A
EDGE_API_HOST=0.0.0.0
EDGE_API_PORT=8001

# Embeddings (FastEmbed, on-device, cached). Nothing downloads at runtime.
EDGE_MODELS_DIR=./models
EDGE_DENSE_MODEL=Qdrant/clip-ViT-B-32-text
EDGE_IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
EDGE_SPARSE_MODEL=Qdrant/bm25
EDGE_DENSE_DIM=512
# When true (default) FastEmbed will ONLY use cached weights and never hit the network.
EDGE_LOCAL_FILES_ONLY=true

# Local LLM (in-process llama.cpp). Path to a GGUF file you downloaded yourself.
EDGE_LLM_ENABLED=true
EDGE_LLM_MODEL_PATH=./models/llm/Llama-3.2-3B-Instruct-Q4_K_M.gguf
EDGE_LLM_CTX=4096
EDGE_LLM_THREADS=4
EDGE_LLM_GPU_LAYERS=0

# Sync policy
EDGE_STORAGE_BUDGET=10000          # max memories kept in the mutable local shard
EDGE_IMPORTANCE_SYNC_THRESHOLD=0.4 # importance >= this => queued for cloud sync
EDGE_DEDUPE_COSINE_THRESHOLD=0.95  # >= => treat as duplicate / merge

# Cloud sync service (the "central brain")
EDGE_CLOUD_URL=http://localhost:8000
EDGE_SYNC_INTERVAL_SECONDS=15

# ── Cloud sync service ──────────────────────────────────────────────────────
CLOUD_API_HOST=0.0.0.0
CLOUD_API_PORT=8000
CLOUD_QDRANT_URL=http://localhost:6333
CLOUD_QDRANT_API_KEY=
CLOUD_COLLECTION=global_memory
CLOUD_DENSE_DIM=512

# Model download (used ONLY by `make download-models`, never at runtime)
DOWNLOAD_LLM_REPO=bartowski/Llama-3.2-3B-Instruct-GGUF
DOWNLOAD_LLM_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf
