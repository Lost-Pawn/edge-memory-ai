# Shared image for the cloud brain and edge device services.
FROM python:3.12-slim

# build-essential + cmake are needed to compile llama-cpp-python (in-process LLM).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[llm]"

# Models and data are mounted at runtime; nothing is downloaded during the build.
ENV EDGE_MODELS_DIR=/models
VOLUME ["/models", "/data"]

EXPOSE 8000 8001
CMD ["uvicorn", "cloud_sync.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
