FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json ./
RUN npm install
COPY frontend ./
RUN npm run build

FROM node:20-slim
WORKDIR /app
RUN npm install -g sirv-cli@2
COPY --from=build /app/dist ./dist
EXPOSE 5173
# Single-page app: serve dist, fall back to index.html for client-side routes.
CMD ["sirv", "dist", "--host", "0.0.0.0", "--port", "5173", "--single"]
